# Copy to .env locally; never commit .env.
PORTAL_BASE_URL=https://portal.example.invalid
PORTAL_PUBLIC_URL=https://portal.example.invalid
PORTAL_GATEWAY_URL=http://192.168.12.1:2050/
PORTAL_LISTEN_HOST=127.0.0.1
PORTAL_LISTEN_PORT=8080
PORTAL_LEASE_ROOT=/tmp
ADMIN_LISTEN_HOST=127.0.0.1
ADMIN_LISTEN_PORT=9090
ADMIN_TOKEN=replace-with-a-long-random-admin-token
DATABASE_URL=postgresql://portal:change-me@127.0.0.1:5432/portal
OPENNDS_FAS_KEY=replace-with-a-random-secret
OPENNDS_GATEWAY_ADDRESS=192.168.12.1
OPENNDS_GATEWAY_INTERFACE=ap0
WIFI_UPSTREAM_INTERFACE=wlan0
WIFI_AP_SSID=MyAccessPoint
PAYMENT_PROVIDER=kcb-buni
PAYMENT_WEBHOOK_SECRET=replace-me

# KCB Buni credentials (fill only on the deployment host, never commit).
# Use the exact names/values issued for your Buni application and environment.
KCB_BUNI_API_BASE_URL=https://uat.buni.kcbgroup.com
KCB_BUNI_TOKEN_PATH=/token?grant_type=client_credentials
KCB_BUNI_STK_PATH=/mm/api/request/1.0.0/stkpush
KCB_BUNI_ROUTE_CODE=207
KCB_BUNI_OPERATION=STKPush
KCB_BUNI_CONSUMER_KEY=replace-me
KCB_BUNI_CONSUMER_SECRET=replace-me
KCB_BUNI_API_KEY=replace-me
KCB_BUNI_CLIENT_CERT_FILE=
KCB_BUNI_CLIENT_KEY_FILE=
KCB_BUNI_TILL_NUMBER=replace-me
KCB_BUNI_CALLBACK_URL=https://portal.example.invalid/payment/kcb/callback
KCB_BUNI_WEBHOOK_SECRET=replace-me
