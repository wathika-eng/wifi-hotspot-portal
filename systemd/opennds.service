[Unit]
Description=openNDS Captive Portal
After=network.target create_ap.service hotspot-firewall.service
Requires=create_ap.service hotspot-firewall.service
StartLimitIntervalSec=10
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/opennds -f
KillMode=process
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
